<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_overlay_dim"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ocean_surface"
        android:padding="32dp"
        android:layout_gravity="center"
        android:elevation="8dp">

        <TextView
            android:id="@+id/rating_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ocean_text"
            android:textSize="32sp"
            android:text="@string/rating_title" />

        <TextView
            android:id="@+id/rating_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ocean_text_secondary"
            android:textSize="22sp"
            android:layout_marginTop="8dp"
            android:text="@string/rating_message" />

        <LinearLayout
            android:id="@+id/actions_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btn_dislike"
                android:layout_width="180dp"
                android:layout_height="64dp"
                android:text="@string/rating_dislike"
                android:textAllCaps="false"
                android:textColor="@color/ocean_text"
                android:background="@drawable/ocean_focus_background"
                android:layout_marginEnd="24dp" />

            <Button
                android:id="@+id/btn_like"
                android:layout_width="180dp"
                android:layout_height="64dp"
                android:text="@string/rating_like"
                android:textAllCaps="false"
                android:textColor="@color/ocean_text"
                android:background="@drawable/ocean_focus_background"
                android:layout_marginEnd="24dp" />

            <Button
                android:id="@+id/btn_love"
                android:layout_width="180dp"
                android:layout_height="64dp"
                android:text="@string/rating_love"
                android:textAllCaps="false"
                android:textColor="@color/ocean_secondary"
                android:background="@drawable/ocean_focus_background"
                android:layout_marginEnd="24dp" />

            <Button
                android:id="@+id/btn_close"
                android:layout_width="180dp"
                android:layout_height="64dp"
                android:text="@string/rating_close"
                android:textAllCaps="false"
                android:textColor="@color/ocean_text"
                android:background="@drawable/ocean_focus_background" />
        </LinearLayout>

        <TextView
            android:id="@+id/countdown_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ocean_text_secondary"
            android:textSize="18sp"
            android:layout_marginTop="12dp"
            android:text="@string/rating_countdown" />
    </LinearLayout>
</FrameLayout>

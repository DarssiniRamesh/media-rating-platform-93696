<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background"
    android:padding="48dp">

    <ImageView
        android:id="@+id/details_poster"
        android:layout_width="560dp"
        android:layout_height="315dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/details_poster_cd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/ocean_surface" />

    <TextView
        android:id="@+id/details_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ocean_text"
        android:textSize="32sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/details_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/details_poster"
        android:layout_marginStart="32dp"
        android:text="Title" />

    <TextView
        android:id="@+id/details_synopsis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ocean_text_secondary"
        android:textSize="22sp"
        android:maxLines="4"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/details_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/details_title"
        android:layout_marginTop="16dp"
        android:text="Synopsis" />

    <Button
        android:id="@+id/rate_button"
        android:layout_width="200dp"
        android:layout_height="64dp"
        android:text="@string/rate_this"
        android:textAllCaps="false"
        android:background="@drawable/ocean_focus_background"
        android:textColor="@color/ocean_text"
        app:layout_constraintStart_toStartOf="@id/details_title"
        app:layout_constraintTop_toBottomOf="@id/details_synopsis"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
